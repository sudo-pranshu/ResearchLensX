# ResearchLens X configuration. Copy to `.env` (git-ignored) and adjust. No API keys are required for any feature.

# Path of the SQLite library used by the Streamlit app (default: data/processed/library.sqlite)
RLX_DB=data/processed/library.sqlite

# Hugging Face cache location (models are downloaded here on first use)
# HF_HOME=~/.cache/huggingface

# Planned (not used yet; see docs/production): Supabase project for authentication in a hosted deployment
# SUPABASE_URL=
# SUPABASE_JWT_SECRET=
