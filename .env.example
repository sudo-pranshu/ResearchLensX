# ResearchLens X configuration. Copy to `.env` (git-ignored) and adjust. No API keys are required for any feature.

# Local data (all optional; defaults shown). Paths may be absolute or relative to the repository root.
# RLX_DATA_DIR=data
# RLX_DB=data/processed/library.sqlite        # SQLite library
# RLX_FILES_DIR=data/library                  # original PDFs
# RLX_EMBEDDING_DIR=artifacts/embeddings

# Server (127.0.0.1 only: there is no authentication, wildcard addresses are refused)
# RLX_HOST=127.0.0.1
# RLX_PORT=8501

# Limits and runtime
# RLX_MAX_UPLOAD_MB=50
# RLX_MAX_PAGES=400
# RLX_DEVICE=auto                             # auto | cpu | mps | cuda
# RLX_WORKSPACE=local

# Hugging Face cache location (models are downloaded here on first use)
# HF_HOME=~/.cache/huggingface

# Planned (not used yet; see docs/production): Supabase project for authentication in a hosted deployment
# SUPABASE_URL=
# SUPABASE_JWT_SECRET=
